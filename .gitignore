# Local config — contains your AcoustID key. Use config.example.yaml as the template.
config.yaml

# Virtual environment + downloaded binaries (the installer recreates these)
.venv/
bin/

# Runtime state, caches, logs, reports, locks
state.sqlite3*
*.sqlite3*
logs/
*.log
review_report.html
*.lock

# Python bytecode
__pycache__/
*.pyc

# Scratch / throwaway test files (but never the package __init__.py)
_*.py
!__init__.py
_test_input/

# generated source bundle (for uploading to a Claude Project)
picardwatch-source.txt
